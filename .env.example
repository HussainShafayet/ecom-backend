# Copy to .env and adjust. `.env` is gitignored, never commit real secrets.

# Settings module: config.settings.dev (local) | config.settings.prod (deployed)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL (see README). Use 127.0.0.1, not "localhost" (IPv6 may hit a different pg_hba rule).
DATABASE_URL=postgres://gocart:gocart@127.0.0.1:5432/gocart

# Browser origins allowed to call the API (frontend dev server runs on :3000).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Needed only when the Django admin is served behind HTTPS / a proxy.
CSRF_TRUSTED_ORIGINS=

# Public URL of the React frontend (product QR codes point to <FRONTEND_URL>/products/detail/<slug>).
FRONTEND_URL=http://localhost:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# /api/docs/ and /api/schema/ (turned off by default in prod)
ENABLE_API_DOCS=True

LOG_LEVEL=INFO

# --- OTP (phone + one-time code sign-in) ---
# Delivery class. Dev default prints the code in the runserver output ("[DEV ONLY] OTP for ...").
# REQUIRED in prod (no default): point it at a real SMS/email class.
OTP_BACKEND=apps.accounts.otp.backends.ConsoleOTPBackend
# DEV ONLY, needs DEBUG=True (refuses to work otherwise, prod rejects it): also shows the code in the API `message`,
# which the frontend displays, e.g. "OTP sent to +88017****5678. [DEV] Your code is 123456."
# OTP_BACKEND=apps.accounts.otp.backends.BrowserOTPBackend
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_MAX_REQUESTS_PER_TARGET_PER_HOUR=5

# Per-client-IP throttles (DRF format: N/second|minute|hour|day)
THROTTLE_OTP_SEND=30/hour
THROTTLE_OTP_VERIFY=60/hour
THROTTLE_TOKEN=60/minute
THROTTLE_ORDER=30/hour
THROTTLE_REVIEW=30/hour  # per signed-in customer

# --- uploads / profile / addresses ---
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=50
MAX_REVIEW_FILES=5
PROFILE_VERIFICATION_WINDOW_SECONDS=900
MAX_ADDRESSES_PER_USER=20
MAX_CART_LINES=50
MAX_FAVOURITES_PER_USER=200

# --- orders ---
# Order numbers read <prefix>-YYYYMMDD-NNNN, e.g. GC-20260923-0001 (letters and digits only).
ORDER_NUMBER_PREFIX=GC
